# 构建产物与本地缓存
/public/
/resources/
/.hugo_build.lock
/.hugo_cache/

# 第三方主题：vendored 离线副本（18MB），由 `make theme` 获取，不入库
/themes/oink/

# 由 tools/convert.py 从 SGML 生成的内容与图片，不入库（make content 重建）
/content/docs/
/static/images/

# 可再生的生成器输入/输出与临时物
/tools/pgsrc/
/tools/pgtree/
/tools/generated/
/tools/generated-zh/
/tools/.loc-tmp/
/tools/convert-warnings.log
__pycache__/
