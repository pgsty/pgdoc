<refsect1 id="R1-SPI-SPIMODIFYTUPLE-3">
<title>Algorithm
</title>
<para>
</para>
</refsect1>
-->
<!--
<refsect1 id="R1-SPI-SPIMODIFYTUPLE-4">
<title>Structures
</title>
<para>None
</para>
</refsect1>
-->
</refentry>

