<refsect2info>
<date>1997-12-24</date>
</refsect2info>
<title>输入
</title>
<variablelist>
<varlistentry>
<term>
HeapTuple <replaceable class="parameter">tuple</replaceable>
</term>
<listitem>
<para>
要复制的输入元组
</para>
</listitem>
</varlistentry>
</variablelist>
</refsect2>

<refsect2 id="R2-SPI-SPICOPYTUPLE-2">
<refsect2info>
<date>1997-12-24</date>
</refsect2info>
<title>输出
</title>
<variablelist>
<varlistentry>
<term>
HeapTuple
</term>
<listitem>
<para>
复制得到的元组
<simplelist>
<member>
 <returnvalue>非 NULL</returnvalue>
 <replaceable class="parameter">tuple</replaceable>
 不为 NULL 且复制成功时
</member>
<member>
   <returnvalue>NULL</returnvalue>
 仅当 <replaceable class="parameter">tuple</replaceable>
 为 NULL 时
</member>
</simplelist>
</listitem>
</varlistentry>
</variablelist>
</refsect2>
</refsynopsisdiv>

<refsect1 id="R1-SPI-SPICOPYTUPLE-1">
<refsect1info>
<date>1997-12-24</date>
