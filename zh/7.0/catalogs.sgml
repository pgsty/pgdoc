.TH "SYSTEM CATALOGS" INTRO 03/13/94 PostgreSQL PostgreSQL
.SH "第 7 节 - 系统目录"
.de LS
.PP
.if n .ta 5 +13 +13
.if t .ta 0.5i +1.3i +1.3i
.in 0
.nf
..
.de LE
.fi
.in
..
.SH "描述"
在这一节中，我们列出系统目录的每个属性并定义它们的含义。.SH "类/类型系统目录"
这些目录构成可扩展性系统的核心：.LS
	\fB名称\fP	\fB共享/本地\fP	\fB描述\fP
	pg_aggregate	local	聚合函数
	pg_am	local	访问方法
	pg_amop	local	可用于特定访问方法的操作符
	pg_amproc	local	与特定访问方法一起使用的过程
	pg_attribute	local	类属性
	pg_class	local	类
	pg_index	local	索引
	pg_inherits	local	类继承层次
	pg_language	local	过程实现语言
	pg_opclass	local	操作符类
	pg_operator	local	查询语言操作符
	pg_proc	local	过程（函数）pg_type	local	数据类型
.LE
.SH "实体"
这些目录处理对整个站点已知的实体的标识：.LS
	\fB名称\fP	\fB共享/本地\fP	\fB描述\fP
	pg_database	shared	当前的数据库
	pg_group	shared	用户组
	pg_shadow	shared	有效用户
.LE
.SH "规则系统目录"
.LS
	\fB名称\fP	\fB共享/本地\fP	\fB描述\fP
	pg_listener	local	等待警报器的进程
	pg_prs2plans	local	实例系统过程
	pg_prs2rule	local	实例系统规则
	pg_prs2stub	local	实例系统“存根”（stub）pg_rewrite	local	重写系统信息
.LE
.SH "大对象目录"
.PP
这些目录特定于 Inversion 文件系统以及一般意义上的大对象：.LS
	\fB名称\fP	\fB共享/本地\fP	\fB描述\fP
	pg_lobj	local	大对象的描述
	pg_naming	local	Inversion 名字空间映射
	pg_platter	local	光盘库盘片清单
	pg_plmap	local	光盘库盘片区段图
.LE
.SH "内部目录"
.PP
这些目录是不作为普通堆存储的内部类，无法通过常规手段访问（尝试这样做会导致错误）。.LS
	\fB名称\fP	\fB共享/本地\fP	\fB描述\fP
	pg_log	shared	事务提交/回滚日志
	pg_magic	shared	魔数常量
	pg_time	shared	提交/回滚时间
	pg_variable	shared	特殊变量值
.LE
.PP
还有若干其他以 \*(lqpg_\*(rq 命名的类。除那些以 \*(lqind\*(rq 结尾的（二级索引）之外，它们都已过时或以其他方式被弃用。.SH "类/类型系统目录"
.PP
以下目录与类/类型系统相关。.nf M
/*
 * aggregates（聚合）*
 * 有关转换函数的解释见 DEFINE AGGREGATE
 */
pg_aggregate
    NameData      aggname	/* 聚合名（例如“count”）*/
    oid         aggowner	/* 创建者的 usesysid */
    regproc     aggtransfn1	/* 第一个转换函数 */
    regproc     aggtransfn2	/* 第二个转换函数 */
    regproc     aggfinalfn	/* 最终函数 */
    oid         aggbasetype	/* 聚合所操作的数据类型 */
    oid         aggtranstype1	/* aggtransfn1 返回的类型 */
    oid         aggtranstype2	/* aggtransfn2 返回的类型 */
    oid         aggfinaltype	/* aggfinalfn 返回的类型 */
    text        agginitval1	/* aggtransfn1 初始（起始）值的外部格式 */
    text        agginitval2	/* aggtransfn2 初始（起始）值的外部格式 */
.fi
.nf M
pg_am
    NameData    amname          /* 访问方法名 */
    oid         amowner         /* 创建者的 usesysid */
    int2        amstrategies    /* 我们可以用来遍历/搜索该 AM 的策略总数 */
    int2        amsupport       /* 该 AM 使用的支持函数的总数 */
    int2        amorderstrategy /* 如果该 AM 有排序顺序，则为排序
                                 * 操作符的策略编号。* AM 无序则为零。*/
    regproc     amgettuple      /* “取下一个有效元组”函数 */
    regproc     aminsert        /* “插入此元组”函数 */
    regproc     amdelete        /* “删除此元组”函数 */
    regproc     amgetattr       /* - 已弃用 */
    regproc     amsetlock       /* - 已弃用 */
    regproc     amsettid        /* - 已弃用 */
    regproc     amfreetuple     /* - 已弃用 */
    regproc     ambeginscan     /* “开始新扫描”函数 */
    regproc     amrescan        /* “重新开始此扫描”函数 */
    regproc     amendscan       /* “结束此扫描”函数 */
    regproc     ammarkpos       /* “标记当前扫描位置”函数 */
    regproc     amrestrpos      /* “恢复已标记扫描位置”函数 */
    regproc     amopen          /* - 已弃用 */
    regproc     amclose         /* - 已弃用 */
    regproc     ambuild         /* “构建新索引”函数 */
    regproc     amcreate        /* - 已弃用 */
    regproc     amdestroy       /* - 已弃用 */
    regproc     amcostestimate  /* 索引扫描的代价估计 */

.fi
.nf M
pg_amop
    oid         amopid		/* 可使用该操作符的访问方法 */
    oid         amopclaid	/* 可使用该操作符的操作符类 */
    oid         amopopr	/* 该操作符 */
    int2        amopstrategy	/* 该操作符所适用的遍历/搜索策略编号 */
.fi
.nf M
pg_amproc
    oid         amid		/* 与该过程相关联的访问方法 */
    oid         amopclaid	/* 可使用该过程的操作符类 */
    oid         amproc		/* 该过程 */
    int2        amprocnum	/* 该过程所适用的支持函数编号 */
.fi
.nf M
pg_class
     NameData     relname	/* 类名 */
     oid        relowner	/* 所有者的 usesysid */
     oid        relam	/* 访问方法 */
     int4       relpages	/* 8KB 页数 */
     int4       reltuples	/* 实例数 */
     abstime    relexpires	/* 此后实例将从非归档存储中删除的时间 */
     reltime    relpreserved	/* 此后实例将从非归档存储中删除的时间段 */
     bool       relhasindex	/* 该类是否有二级索引？*/
     bool       relisshared	/* 该类是共享还是本地？*/
     char       relkind		/* 关系类型：i=索引
				   r=关系（堆）s=特殊
				   u=未编目（临时）*/
     char       relarch	/* 归档模式：h=重
			   l=轻
			   n=无 */
     int2       relnatts	/* 当前非系统属性数 */
     int2       relsmgr	/* 存储管理器：0=磁盘
			   1=索尼 WORM 光盘库
			   2=主内存 */
     int2vector relkey		/* - 未使用 */
     oidvector  relkeyop	/* - 未使用 */
     aclitem    relacl[1]	/* 访问控制列表 */
.fi
.nf M
pg_attribute
    oid         attrelid	/* 包含该属性的类 */
    NameData      attname	/* 属性名 */
    oid         atttypid	/* 属性类型 */
    oid         attdefrel	/* - 已弃用 */
    int4        attnvals	/* - 已弃用 */
    oid         atttyparg	/* - 已弃用 */
    int2        attlen	/* 属性长度（字节）-1=变长 */
    int2        attnum	/* 属性编号
			   >0=用户属性
			   <0=系统属性 */
    int2        attbound	/* - 已弃用 */
    bool        attbyval	/* 类型按值传递？*/
    bool        attcanindex	/* - 已弃用 */
    oid         attproc	/* - 已弃用 */
    int4        attnelems	/* 数组维数 */
    int4        attcacheoff	/* 元组内的偏移量缓存 */
    bool        attisset	/* 属性是否为集合值？*/
.fi
.nf M
pg_inherits
    oid         inhrel	/* 子类 */
    oid         inhparent	/* 父类 */
    int4        inhseqno	/* - 已弃用 */
.fi
.nf M
    oid         indexrelid	/* 二级索引类的 oid */
    oid         indrelid	/* 被索引堆类的 oid */
    oid         indproc	/* 从堆中属性计算索引键的函数
				   0=不是函数索引 */
    int2vector  indkey	/* 键属性的属性编号 */
    oidvector   indclass	/* 每个键的 opclass */
    bool        indisclustered	/* 索引是否聚簇？- 未使用 */
    bool        indisarchived	/* 索引是否归档？- 未使用 */
    text        indpred	/* 部分索引谓词的查询计划 */
.fi
.nf M
pg_type
    NameData      typname	/* 类型名 */
    oid         typowner	/* 所有者的 usesysid */
    int2        typlen	/* 内部形式的长度
			   -1=变长 */
    int2        typprtlen	/* 外部形式的长度 */
    bool        typbyval	/* 类型按值传递？*/
    char        typtype	/* 类型种类：c=目录（复合）b=基本 */
    bool        typisdefined	/* 已定义还是仍为壳？*/
    char        typdelim	/* 数组外部形式的分隔符 */
    oid         typrelid	/* 类（如果复合）*/
    oid         typelem	/* 每个数组元素的类型 */
    regproc     typinput	/* 外部-内部转换函数 */
    regproc     typoutput	/* 内部-外部转换函数 */
    regproc     typreceive	/* 客户端-服务器转换函数 */
    regproc     typsend	/* 服务器-客户端转换函数 */
    text        typdefault	/* 默认值 */
.fi
.nf M
pg_operator
    NameData      oprname	/* 操作符名 */
    oid         oprowner	/* 所有者的 usesysid */
    int2        oprprec	/* - 已弃用 */
    char        oprkind	/* 操作符种类：b=二元
			   l=左一元
			   r=右一元 */
    bool        oprisleft	/* 操作符是左结合还是右结合？*/
    bool        oprcanhash	/* 操作符是否可用于哈希连接？*/
    oid         oprleft	/* 左操作数类型 */
    oid         oprright	/* 右操作数类型 */
    oid         oprresult	/* 结果类型 */
    oid         oprcom	/* 交换子操作符 */
    oid         oprnegate	/* 否定子操作符 */
    oid         oprlsortop	/* 左操作数的排序操作符 */
    oid         oprrsortop	/* 右操作数的排序操作符 */
    regproc     oprcode	/* 实现该操作符的函数 */
    regproc     oprrest	/* 计算操作符限制选择率的函数 */
    regproc     oprjoin	/* 计算操作符连接选择率的函数 */
.fi
.nf M
pg_opclass
    NameData      opcname	/* 操作符类名 */
.fi
.nf M
pg_proc
    NameData      proname	/* 函数名 */
    oid         proowner	/* 所有者的 usesysid */
    oid         prolang	/* 函数实现语言 */
    bool        proisinh	/* - 已弃用 */
    bool        proistrusted	/* 在服务器中运行还是在不可信函数进程中运行？*/
    bool        proiscachable	/* 函数的返回值可以缓存吗？*/
    int2        pronargs	/* 参数个数 */
    bool        proretset	/* 函数是否返回集合？- 未使用 */
    oid         prorettype	/* 返回类型 */
    oidvector   proargtypes	/* 参数类型 */
    int4        probyte_pct	/* 为计算该函数所需检查的参数大小（字节）的百分比 */
    int4        properbyte_cpu	/* 函数运行时间对其输入大小的敏感度 */
    int4        propercall_cpu	/* 函数调用的开销（与输入大小无关）*/
    int4        prooutin_ratio	/* 函数输出大小相对输入大小的百分比 */
    text        prosrc	/* 函数定义：INTERNAL 函数：函数的实际 C 名
			   C 函数：目前该字段未使用
			   SQL 函数：查询文本
			   PL 函数：过程语言的文本 */
    bytea       probin	/* 目标文件路径（仅 C 函数）*/
.fi
.nf M
pg_language
    NameData      lanname	/* 语言名 */
    text        lancompiler	/* - 已弃用 */
.fi
.SH "实体"
.nf M
pg_database
    NameData      datname		/* 数据库名 */
    oid         datdba		/* 数据库管理员的 usesysid */
    text        datpath		/* 数据库在
				   $PGDATA 下的目录 */
.fi
.nf M
pg_group
    NameData      groname	/* 组名 */
    int2        grosysid	/* 组的 UNIX 组 id */
    int2        grolist[1]	/* 组成员的 usesysid 列表 */
.fi
.nf M
pg_shadow
    NameData      usename		/* 用户名 */
    int2        usesysid	/* 用户的 UNIX 用户 id */
    bool        usecreatedb	/* 用户可以创建数据库？*/
    bool        usetrace	/* 用户可以设置跟踪标志？*/
    bool        usesuper	/* 用户可以是 POSTGRES 超级用户？*/
    bool        usecatupd	/* 用户可以更新目录？*/
.fi
.SH "规则系统目录"
.nf M
pg_listener
    NameData      relname	/* 希望对其获得异步通知的类 */
    int4        listenerpid	/* 与等待异步通知的前端程序相对应的服务器进程 id */
    int4        notification	/* 该进程 id 是否仍有待处理的事件通知 */

.fi
.nf M
pg_prs2rule
    NameData      prs2name	/* 规则名 */
    char        prs2eventtype	/* 规则事件类型：R=检索
				   U=更新（替换）A=追加
				   D=删除 */
    oid         prs2eventrel	/* 事件所适用的类 */
    int2        prs2eventattr	/* 事件所适用的属性 */
    float8      necessary	/* - 已弃用 */
    float8      sufficient	/* - 已弃用 */
    text        prs2text	/* 原始规则定义的文本 */
.fi
.nf M
pg_prs2plans
    oid         prs2ruleid	/* 使用该计划的
				   prs2rule 实例 */
    int2        prs2planno	/* 计划编号（一条规则可能调用多个计划）*/
    text        prs2code	/* 计划的外部表示 */
.fi
.nf M
pg_prs2stub
    oid         prs2relid	/* 该规则所适用的类 */
    bool        prs2islast	/* 这是最后一个存根片段？*/
    int4        prs2no		/* 存根片段编号 */
    stub        prs2stub	/* 存根片段 */
.fi
.nf M
pg_rewrite
    NameData      rulename	/* 规则名 */
    char        ev_type	/* 事件类型：RETRIEVE、REPLACE、APPEND、DELETE
				   代码依赖于解析器（!?）*/
    oid         ev_class	/* 该规则所适用的类 */
    int2        ev_attr	/* 该规则所适用的属性 */
    bool        is_instead	/* 这是“instead”规则吗？*/
    text        ev_qual	/* 用来修改（重写）触发该规则的计划的限定条件 */
    text        action	/* 动作的解析树 */
.fi
.SH "大对象目录"
.nf M
pg_lobj
    oid         ourid		/* pg_naming 中的‘ourid’，在 Inversion 文件系统名字空间中标识该对象 */
    int4        objtype		/* 存储类型代码：0=Inversion
				   1=Unix
				   2=External
				   3=Jaquith */
    bytea       object_descripto/* 不透明的对象句柄结构 */
.fi
.nf M
pg_naming
    NameData      filename	/* 文件名分量 */
    oid         ourid		/* 用于在其他实例中标识该实例的随机 oid（出于某些晦涩的原因不能使用实际的 oid）*/
    oid         parentid	/* 父 Inversion 文件系统目录的
				   pg_naming 实例 */
.fi
.nf M
pg_platter
     NameData     plname		/* 盘片名 */
     int4       plstart		/* 最高的已占用区段 */
.fi
.nf M
pg_plmap
     oid        plid		/* 该区段（块组）所在的盘片（在 pg_platter 中）*/
     oid        pldbid		/* 该区段（块组）所属的类所在的数据库 */
     oid        plrelid		/* 该区段（块组）所属的类 */
     int4       plblkno		/* 类内的起始块号 */
     int4       ploffset	/* 该区段在盘片上开始处的偏移量 */
     int4       plextentsz	/* 该区段的长度 */
.fi
