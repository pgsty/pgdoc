	 <entry>int4</entry>
	 <entry>include/postgres.h</entry>
	</row>
	<row>
	 <entry>float4</entry>
	 <entry>float32 或 (float4 *)</entry>
	<entry>include/c.h 或 include/postgres.h</entry>
	</row>
	<row>
	 <entry>float8</entry>
	 <entry>float64 或 (float8 *)</entry>
	 <entry>include/c.h 或 include/postgres.h</entry>
