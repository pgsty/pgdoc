	 <entry>include/postgres.h</entry>
	</row>
	<row>
	 <entry>oid</entry>
	 <entry>oid</entry>
	 <entry>include/postgres.h</entry>
	</row>
	<row>
	 <entry>oidvector</entry>
	 <entry>(oidvector *)</entry>
	 <entry>include/postgres.h</entry>
	</row>
	<row>
	 <entry>path</entry>
