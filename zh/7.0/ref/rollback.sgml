Postgres documentation
-->

<refentry id="SQL-ROLLBACK">
 <refmeta>
  <refentrytitle id="SQL-ROLLBACK-TITLE">
   ROLLBACK
  </refentrytitle>
  <refmiscinfo>SQL - 语言语句</refmiscinfo>
 </refmeta>
 <refnamediv>
  <refname>
   ROLLBACK
  </refname>
  <refpurpose>
   中止当前的事务
  </refpurpose>
 </refnamediv>
 <refsynopsisdiv>
  <refsynopsisdivinfo>
   <date>1999-07-20</date>
  </refsynopsisdivinfo>
  <synopsis>
ROLLBACK [ WORK | TRANSACTION ]
  </synopsis>

  <refsect2 id="R2-SQL-ROLLBACK-1">
   <refsect2info>
    <date>1998-09-24</date>
   </refsect2info>
   <title>
    输入
   </title>
   <para>
    无。
   </para>
  </refsect2>

  <refsect2 id="R2-SQL-ROLLBACK-2">
   <refsect2info>
    <date>1998-09-24</date>
   </refsect2info>
   <title>
    输出
   </title>
   <para>
	
    <variablelist>
     <varlistentry>
      <term><computeroutput>
ABORT
       </computeroutput></term>
      <listitem>
       <para>
	成功时返回的消息。
       </para>
      </listitem>
     </varlistentry>
     
     <varlistentry>
      <term><computeroutput>
NOTICE:  ROLLBACK: no transaction in progress
       </computeroutput></term>
      <listitem>
       <para>
	如果当前没有正在进行的事务。
       </para>
      </listitem>
     </varlistentry>
    </variablelist>
   </para>
  </refsect2>
 </refsynopsisdiv>

 <refsect1 id="R1-SQL-ROLLBACK-1">
  <refsect1info>
   <date>1998-09-24</date>
  </refsect1info>
  <title>
   描述
  </title>

  <para>
   <command>ROLLBACK</command> 回滚当前事务并使该事务所做的所有更新被丢弃。
  </para>

  <refsect2 id="R2-SQL-ROLLBACK-3">
   <refsect2info>
    <date>1998-09-24</date>
   </refsect2info>
   <title>
    注意
   </title>
   <para>
    使用<xref linkend="SQL-COMMIT-TITLE" endterm="SQL-COMMIT-TITLE">成功地终止一个事务。<xref linkend="SQL-ABORT-TITLE" endterm="SQL-ABORT-TITLE">是
    <command>ROLLBACK</command> 的一个同义词。
   </para>
  </refsect2>
 </refsect1>

 <refsect1 id="R1-SQL-ROLLBACK-2">
  <title>
   用法
  </title>
  <para>
   要中止所有更改：

   <programlisting>
ROLLBACK WORK;
   </programlisting>
  </para>
 </refsect1>

 <refsect1 id="R1-SQL-ROLLBACK-3">
  <title>
   兼容性
  </title>

  <refsect2 id="R2-SQL-ROLLBACK-4">
   <refsect2info>
    <date>1998-09-24</date>
   </refsect2info>
   <title>
    SQL92
   </title>
   <para>
    <acronym>SQL92</acronym> 只指定了
    <literal>ROLLBACK</literal> 和
    <literal>ROLLBACK WORK</literal> 两种形式。除此之外完全兼容。
   </para>
  </refsect2>
 </refsect1>
</refentry>

