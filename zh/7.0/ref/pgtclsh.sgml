Postgres documentation
-->

<refentry id="APP-PGTCLSH">
 <refmeta>
  <refentrytitle id="app-pgtclsh-title">
   <application>pgtclsh</application>
  </refentrytitle>
  <refmiscinfo>应用程序</refmiscinfo>
 </refmeta>
 <refnamediv>
  <refname>
   <application>pgtclsh</application>
  </refname>
  <refpurpose>
   <productname>Postgres</productname> TCL shell 客户端
  </refpurpose>
 </refnamediv>
 <refsynopsisdiv>
  <refsynopsisdivinfo>
   <date>1999-08-03</date>
  </refsynopsisdivinfo>
  <synopsis>
pgtclsh [ <replaceable class="parameter">dbname</replaceable> ]
  </synopsis>
 
  <refsect2 id="R2-APP-PGTCLSH-1">
   <title>
    输入
   </title>
   <para>
 
    <variablelist>
     <varlistentry>
      <term><replaceable class="PARAMETER">dbname</replaceable></term>
      <listitem>
       <para>
	要访问的一个现有数据库的名称。
       </para>
      </listitem>
     </varlistentry>
    </variablelist>
   </para>
  </refsect2>
 
  <refsect2 id="R2-APP-PGTCLSH-2">
   <title>
    输出
   </title>
   <para>
   </para>
  </refsect2>
 </refsynopsisdiv>
 
 <refsect1 id="R1-APP-PGTCLSH-1">
  <title>
   描述
  </title>
  <para>
   <application>pgtclsh</application> 为
   <productname>Postgres</productname> 提供一个 TCL shell 接口。
  </para>
 
  <para>
   通过 tcl 访问
   <productname>Postgres</productname> 的另一种
   方式是使用
   <xref linkend="app-pgtksh" endterm="app-pgtksh-title">
   或
   <xref linkend="app-pgaccess" endterm="app-pgaccess-title">。
  </para>
 </refsect1>
</refentry>


