<refentry id="APP-PGTKSH">
 <refmeta>
  <refentrytitle id="app-pgtksh-title">
   <application>pgtksh</application>
  </refentrytitle>
  <refmiscinfo>Application</refmiscinfo>
 </refmeta>

 <refnamediv>
  <refname>
   <application>pgtksh</application>
  </refname>
  <refpurpose>
   <productname>Postgres</productname> 图形化 TCL/TK shell
  </refpurpose>
 </refnamediv>

 <refsynopsisdiv>
  <refsynopsisdivinfo>
   <date>1999-08-03</date>
  </refsynopsisdivinfo>
  <synopsis>
pgtksh [ <replaceable class="parameter">dbname</replaceable> ]
  </synopsis>

  <refsect2 id="R2-APP-PGTKSH-1">
   <title>
    输入
   </title>
   <para>

    <variablelist>
     <varlistentry>
      <term><replaceable class="PARAMETER">dbname</replaceable></term>
      <listitem>
       <para>
	要访问的现有数据库的名称。
       </para>
      </listitem>
     </varlistentry>
    </variablelist>
   </para>
  </refsect2>

  <refsect2 id="R2-APP-PGTKSH-2">
   <title>
    输出
   </title>
   <para>
   </para>
  </refsect2>
 </refsynopsisdiv>

 <refsect1 id="R1-APP-PGTKSH-1">
  <title>
   描述
  </title>
  <para>
   <application>pgtksh</application> 为
   <productname>Postgres</productname>提供一个图形化 TCL/TK shell
   接口。
  </para>
  <para>
   访问 <productname>Postgres</productname>
   的另一种方式是使用 <acronym>TCL</acronym>，即使用<xref linkend="app-pgtclsh" endterm="app-pgtclsh-title">或<xref linkend="app-pgaccess" endterm="app-pgaccess-title">。
  </para>
 </refsect1>

</refentry>