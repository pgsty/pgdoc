Postgres documentation
-->

<refentry id="SQL-RESET">
 <refmeta>
  <refentrytitle id="SQL-RESET-TITLE">
   RESET
  </refentrytitle>
  <refmiscinfo>SQL - 语言语句</refmiscinfo>
 </refmeta>
 <refnamediv>
  <refname>
   RESET
  </refname>
  <refpurpose>
   恢复会话的运行时参数为默认值
  </refpurpose>
 </refnamediv>
 <refsynopsisdiv>
  <refsynopsisdivinfo>
   <date>1999-07-20</date>
  </refsynopsisdivinfo>
  <synopsis>
RESET <replaceable class="PARAMETER">variable</replaceable>
  </synopsis>

  <refsect2 id="R2-SQL-RESET-1">
   <refsect2info>
    <date>1998-09-24</date>
   </refsect2info>
   <title>
    输入
   </title>
   <para>		
    <variablelist>
     <varlistentry>
      <term><replaceable class="PARAMETER">variable</replaceable></term>
      <listitem>
       <para>
	有关可用变量的更多信息，请参阅<xref linkend="sql-set-title" endterm="sql-set-title">。
       </para>
      </listitem>
     </varlistentry>
    </variablelist>
   </para>
  </refsect2>

  <refsect2 id="R2-SQL-RESET-2">
   <refsect2info>
    <date>1998-09-24</date>
   </refsect2info>
   <title>
    输出
   </title>
   <para>

    <variablelist>
     <varlistentry>
      <term><computeroutput>
RESET VARIABLE
       </computeroutput></term>
      <listitem>
       <para>
	如果<replaceable class="PARAMETER">variable</replaceable>被成功重置为默认值，返回此消息。
       </para>
      </listitem>
     </varlistentry>
    </variablelist>
   </para>
  </refsect2>
 </refsynopsisdiv>
  
 <refsect1 id="R1-SQL-RESET-1">
  <refsect1info>
   <date>1998-09-24</date>
  </refsect1info>
  <title>
   描述
  </title>
  <para>
   <command>RESET</command>把变量恢复为默认值。有关允许的取值和默认值，请参阅<xref linkend="sql-set-title" endterm="sql-set-title">。<command>RESET</command>是下面语句的替代形式

   <synopsis>
SET <replaceable class="parameter">variable</replaceable> = DEFAULT
   </synopsis>
  </para>

  <refsect2 id="R2-SQL-RESET-3">
   <refsect2info>
    <date>1998-09-24</date>
   </refsect2info>
   <title>
    注意
   </title>

   <para>
    另外还可以使用<xref linkend="sql-set-title" endterm="sql-set-title">和<xref linkend="sql-show-title" endterm="sql-show-title">来操作变量的值。
   </para>
  </refsect2>
 </refsect1>
  
 <refsect1 id="R1-SQL-RESET-2">
  <title>
   用法
  </title>
  <para>
   把 DateStyle 设为默认值：

   <programlisting>
RESET DateStyle;
   </programlisting>
  </para>

  <para>
   把 Geqo 设为默认值：

   <programlisting>   
RESET GEQO;
   </programlisting>
  </para>
 </refsect1>

 <refsect1 id="R1-SQL-RESET-3">
  <title>
   兼容性
  </title>

  <refsect2 id="R2-SQL-RESET-4">
   <refsect2info>
    <date>1998-09-24</date>
   </refsect2info>
   <title>
    SQL92
   </title>
   <para>
    <acronym>SQL92</acronym>中没有<command>RESET</command>。
   </para>
  </refsect2>
 </refsect1>
</refentry>

