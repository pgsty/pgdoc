<entry><literal>02000</literal></entry>
<entry>无数据</entry>
<entry>no_data</entry>
</row>

<row>
<entry><literal>02001</literal></entry>
<entry>没有更多动态结果集返回</entry>
<entry>no_additional_dynamic_result_sets_returned</entry>
</row>


