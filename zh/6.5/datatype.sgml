    <para>
     <table tocentry="1">
      <title><productname>Postgres</productname> 时间输入</title>
      <titleabbrev>时间输入</titleabbrev>
      <tgroup cols="2">
       <thead>
	<row>
	 <entry>示例</entry>
	 <entry>描述</entry>
	</row>
       </thead>
