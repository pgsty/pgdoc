	</row>
	<row>
	 <entry>1999.008</entry>
	 <entry>年和一年中的日子</entry>
	</row>
	<row>
	 <entry>99008</entry>
	 <entry>年和一年中的日子</entry>
	</row>
	<row>
	 <entry>January 8, 99 BC</entry>
	 <entry>公元前的 99 年</entry>
	</row>
       </tbody>
      </tgroup>
     </table>
    </para>

    <para>
     <table tocentry="1">
