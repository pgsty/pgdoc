    <listitem>
     <para>
      修复 <filename>pg_multixact/members</filename> 的回卷处理（&Aacute;lvaro Herrera）
     </para>
    </listitem>

<!--
Author: Alvaro Herrera <alvherre@alvh.no-ip.org>
Branch: master [f741300c9] 2014-06-27 14:43:53 -0400
