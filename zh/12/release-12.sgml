     <para>修复服务器中多种较小的内存泄漏（Tom Lane，Andres Freund） <ulink url="&commit_baseurl;2f31414f4">&sect;</ulink>
      <ulink url="&commit_baseurl;4eca51d44">&sect;</ulink>
      <ulink url="&commit_baseurl;fc552f868">&sect;</ulink>
      <ulink url="&commit_baseurl;92bc14a10">&sect;</ulink>
      <ulink url="&commit_baseurl;1452a0bb8">&sect;</ulink>
      <ulink url="&commit_baseurl;fbcc9fe33">&sect;</ulink>
      <ulink url="&commit_baseurl;6e3475556">&sect;</ulink></para>
    </listitem>

    <listitem>
