Branch: REL_12_STABLE [b2fd1dab9] 2024-01-29 12:06:08 -0500
-->
     <para>
      修复 <application>libxml2</application>
      版本 2.12.0 及更高版本的编译失败（Tom Lane）
      <ulink url="&commit_baseurl;b2fd1dab9">&sect;</ulink>
     </para>
    </listitem>

    <listitem>
<!--
Author: Tom Lane <tgl@sss.pgh.pa.us>
