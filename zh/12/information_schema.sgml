      <entry><type>cardinal_number</type></entry>
      <entry>
       总是为 null，因为这种信息不适用于<productname>PostgreSQL</productname>中的参数数据类型
      </entry>
     </row>

     <row>
      <entry><literal>udt_catalog</literal></entry>
      <entry><type>sql_identifier</type></entry>
      <entry>
