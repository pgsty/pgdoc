   <title>SQL Functions</title>

   <partintro>
    <para>
     This part provides reference information for the
     <acronym>SQL</acronym> functions supported by
     <productname>PostgreSQL</productname>.
    </para>

   &currentDate;
   &currentTime;
   &currentTimestamp;
   &currentUser;
  </reference>
