PostgreSQL documentation
-->

<refentry id="SQL-END">
 <refmeta>
  <refentrytitle id="SQL-END-TITLE">END</refentrytitle>
  <refmiscinfo>SQL - 语言语句</refmiscinfo>
 </refmeta>
 <refnamediv>
  <refname>
   END
  </refname>
  <refpurpose>
   提交当前事务
  </refpurpose>
 </refnamediv>  
  
 <refsynopsisdiv>
  <refsynopsisdivinfo>
   <date>1999-07-20</date>
  </refsynopsisdivinfo>
  <synopsis>
END [ WORK | TRANSACTION ]
  </synopsis>
  
  <refsect2 id="R2-SQL-END-1">
   <refsect2info>
    <date>1998-09-08</date>
   </refsect2info>
   <title>
    输入
   </title>
   <para>
    <variablelist>
     <varlistentry>
      <term>WORK</term>
      <term>TRANSACTION</term>
      <listitem>
       <para>
	可选的关键字。它们没有效果。
       </para>
      </listitem>
     </varlistentry>
    </variablelist>
   </para>
  </refsect2>
  <refsect2 id="R2-SQL-END-2">
   <refsect2info>
    <date>1998-09-08</date>
   </refsect2info>
   <title>
    输出
   </title>
   <para>
    <variablelist>
     <varlistentry>
      <term><computeroutput>
COMMIT
       </computeroutput></term>
      <listitem>
       <para>
	事务被成功提交时返回的消息。
       </para>
      </listitem>
     </varlistentry>
     <varlistentry>
      <term><computeroutput>
WARNING:  COMMIT: no transaction in progress
       </computeroutput></term>
      <listitem>
       <para>
	如果没有正在进行的事务。
       </para>
      </listitem>
     </varlistentry>
    </variablelist>
   </para>
  </refsect2>
 </refsynopsisdiv>
 <refsect1 id="R1-SQL-END-1">
  <refsect1info>
   <date>1998-09-08</date>
  </refsect1info>
  <title>
   描述
  </title>
  <para>
   <command>END</command> 是一种
   <productname>PostgreSQL</productname>
   扩展，是
   SQL92 兼容的
   <xref linkend="sql-commit" endterm="sql-commit-title">
   的同义词。
  </para>
  <refsect2 id="R2-SQL-END-3">
   <refsect2info>
    <date>1998-09-08</date>
   </refsect2info>
   <title>
    注意
   </title>
   <para>
    关键字 WORK 和 TRANSACTION 是噪声词，可以省略。
   </para>
   <para>
    使用 <xref linkend="SQL-ROLLBACK" endterm="SQL-ROLLBACK-TITLE">
    中止一个事务。
   </para>
  </refsect2>
 </refsect1>
 <refsect1 id="R1-SQL-END-2">
  <title>
   用法
  </title>
  <para>
   要使所有更改永久化：
   <programlisting>
END WORK;
   </programlisting>
  </para>
 </refsect1>
 <refsect1 id="R1-SQL-END-3">
  <title>
   兼容性
  </title>
  <refsect2 id="R2-SQL-END-4">
   <refsect2info>
    <date>1998-09-08</date>
   </refsect2info>
   <title>
    SQL92
   </title>
   <para>
    <command>END</command> 是一种提供与
    <xref linkend="sql-commit" endterm="sql-commit-title">
    等价功能的
    <productname>PostgreSQL</productname>
    扩展。
   </para>
  </refsect2>
 </refsect1>
</refentry>
