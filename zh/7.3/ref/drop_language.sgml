PostgreSQL documentation
-->

<refentry id="SQL-DROPLANGUAGE">
 <refmeta>
  <refentrytitle id="SQL-DROPLANGUAGE-TITLE">DROP LANGUAGE</refentrytitle>
  <refmiscinfo>SQL - 语言语句</refmiscinfo>
 </refmeta>
 <refnamediv>
  <refname>
   DROP LANGUAGE
  </refname>
  <refpurpose>
   移除一个用户定义的过程语言
  </refpurpose>
 </refnamediv>
 <refsynopsisdiv>
  <refsynopsisdivinfo>
   <date>1999-07-20</date>
  </refsynopsisdivinfo>
  <synopsis>
DROP [ PROCEDURAL ] LANGUAGE <replaceable class="PARAMETER">name</replaceable> [ CASCADE | RESTRICT ]
  </synopsis>
  
  <refsect2 id="R2-SQL-DROPLANGUAGE-1">
   <refsect2info>
    <date>1998-04-15</date>
   </refsect2info>
   <title>
   输入
  </title>
   <para>

    <variablelist>
     <varlistentry>
      <term><replaceable class="PARAMETER">name</replaceable></term>
      <listitem>
       <para>现有过程语言的名称。为向后兼容，名称可以用单引号括起。
       </para>
      </listitem>
     </varlistentry>
     <varlistentry>
      <term>CASCADE</term>
      <listitem>
       <para>
      自动删除依赖于该语言的对象（例如以该语言编写的函数）。
       </para>
      </listitem>
     </varlistentry>
     <varlistentry>
      <term>RESTRICT</term>
      <listitem>
       <para>
        如果有任何依赖对象则拒绝删除该语言。这是默认行为。
       </para>
      </listitem>
     </varlistentry>
    </variablelist>

   </para>
  </refsect2>
  
  <refsect2 id="R2-SQL-DROPLANGUAGE-2">
   <refsect2info>
    <date>1998-04-15</date>
   </refsect2info>
   <title>
   输出
  </title>
   <para>
    <variablelist>
     <varlistentry>
      <term><computeroutput>
DROP LANGUAGE
       </computeroutput></term>
      <listitem>
       <para>
	语言成功删除时返回此消息。
       </para>
      </listitem>
     </varlistentry>
     <varlistentry>
      <term><computeroutput>
ERROR: Language "<replaceable class="parameter">name</replaceable>" doesn't exist
       </computeroutput></term>
      <listitem>
       <para>
	如果数据库中没有名为
	<replaceable class="parameter">name</replaceable>
	的语言，就会出现这条消息。
       </para>
      </listitem>
     </varlistentry>
    </variablelist>
   </para>
  </refsect2>
 </refsynopsisdiv>
 
 <refsect1 id="R1-SQL-DROPLANGUAGE-1">
  <refsect1info>
   <date>1998-04-15</date>
  </refsect1info>
  <title>
   描述
  </title>
  <para>
   <command>DROP PROCEDURAL LANGUAGE</command> 将删除此前注册的名为
   <replaceable class="parameter">name</replaceable>
   的过程语言的定义。
  </para>
  
  <refsect2 id="R2-SQL-DROPLANGUAGE-3">
   <refsect2info>
    <date>1998-04-15</date>
   </refsect2info>
   <title>
   注意
  </title>
   <para>
    <command>DROP PROCEDURAL LANGUAGE</command> 语句是一种
    <productname>PostgreSQL</productname>
    语言扩展。
   </para>
   <para>
    关于如何创建过程语言的信息，参见<xref linkend="sql-createlanguage" endterm="sql-createlanguage-title">。
   </para>
  </refsect2>
 </refsect1>
 
 <refsect1 id="R1-SQL-DROPLANGUAGE-2">
  <title>
   用法
  </title>
  <para>
   这条命令删除 PL/Sample 语言：

   <programlisting>
DROP LANGUAGE plsample;
   </programlisting>
  </para>
 </refsect1>
 
 <refsect1 id="R1-SQL-DROPLANGUAGE-3">
  <title>
   兼容性
  </title>
  
  <refsect2 id="R2-SQL-DROPLANGUAGE-5">
   <refsect2info>
    <date>1998-04-15</date>
   </refsect2info>
   <title>
    SQL92
   </title>
   <para>
    <acronym>SQL92</acronym> 中没有
    <command>DROP PROCEDURAL LANGUAGE</command>。
   </para>
  </refsect2>
 </refsect1>
</refentry>

