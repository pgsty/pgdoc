<REFENTRY ID="SQL-CURRENT-DATE">
 <REFMETA>
  <REFENTRYTITLE>CURRENT_DATE</REFENTRYTITLE>
  <REFMISCINFO>SQL - 函数</REFMISCINFO>
 </REFMETA>
 <REFNAMEDIV>
  <REFNAME>
   CURRENT_DATE
  </REFNAME>
  <REFPURPOSE>
返回当前日期
  </REFPURPOSE>
 <REFSYNOPSISDIV>
  <REFSYNOPSISDIVINFO>
   <DATE>1998-04-15</DATE>
  </REFSYNOPSISDIVINFO>
  <SYNOPSIS>
   CURRENT_DATE
  </SYNOPSIS>
  
  <REFSECT2 ID="R2-SQL-CURRENT-DATE-1">
   <REFSECT2INFO>
    <DATE>1998-04-15</DATE>
   </REFSECT2INFO>
   <TITLE>
    输入
   </TITLE>
   <PARA>
无。
  </REFSECT2>
  
  <REFSECT2 ID="R2-SQL-CURRENT-DATE-2">
   <REFSECT2INFO>
    <DATE>1998-04-15</DATE>
   </REFSECT2INFO>
   <TITLE>
    输出
   </TITLE>
   <PARA>
       <VARIABLELIST>
	<VARLISTENTRY>
	 <TERM>
<replaceable>date</replaceable>

	 </TERM>
	 <LISTITEM>
	  <PARA>
	  返回"<replaceable class="parameter">today</replaceable>"。
   </VARIABLELIST>
  </REFSECT2>
 </REFSYNOPSISDIV>
 
 <REFSECT1 ID="R1-SQL-CURRENT-DATE-1">
  <REFSECT1INFO>
   <DATE>1998-04-15</DATE>
  </REFSECT1INFO>
  <TITLE>
   描述
  </TITLE>
  <PARA>
   CURRENT_DATE 是一个无参（niladic）函数，其数据类型为
   DATE，它在运行时返回当时的日期。
  </PARA>
  
  <REFSECT2 ID="R2-SQL-CURRENT-DATE-3">
   <REFSECT2INFO>
    <DATE>1998-04-15</DATE>
   </REFSECT2INFO>
   <TITLE>
    注意
   </TITLE>
   <PARA>
    有关日期格式的更多信息，请参阅 SET DATESTYLE。
   </PARA>
  </REFSECT2>
  
 <REFSECT1 ID="R1-SQL-CURRENT-DATE-2">
  <TITLE>
   用法
  </TITLE>
  <PARA>
   把插入时的日期插入到一行中：
  </PARA>
  <ProgramListing>
   INSERT INTO films
         VALUES ('TM999','Ben Hur',105,CURRENT_DATE,'Action',NULL);
  </ProgramListing>
  
  <PARA>
   显示 CURRENT-DATE：
  </PARA>
  <ProgramListing>
   SELECT CURRENT_DATE AS today;

   today
   ------------
   1998-03-31

  </ProgramListing>
 </REFSECT1>
 
 <REFSECT1 ID="R1-SQL-CURRENT-DATE-3">
  <TITLE>
   兼容性
  </TITLE>
  <PARA>
  </PARA>
  
  <REFSECT2 ID="R2-SQL-CURRENT-DATE-4">
   <REFSECT2INFO>
    <DATE>1998-04-15</DATE>
   </REFSECT2INFO>
   <TITLE>
    SQL92
   </TITLE>
   <PARA>
    完全兼容。
   </PARA>
  </refsect2>
 </refsect1>
</REFENTRY>

