PostgreSQL documentation
-->

<refentry id="SQL-DROPRULE">
 <refmeta>
  <refentrytitle id="SQL-DROPRULE-TITLE">DROP RULE</refentrytitle>
  <refmiscinfo>SQL - 语言语句</refmiscinfo>
 </refmeta>

 <refnamediv>
  <refname>
   DROP RULE
  </refname>
  <refpurpose>
   删除一个重写规则
  </refpurpose>
 </refnamediv>

 <refsynopsisdiv>
  <refsynopsisdivinfo>
   <date>1999-07-20</date>
  </refsynopsisdivinfo>
  <synopsis>
DROP RULE <replaceable class="PARAMETER">name</replaceable> ON <replaceable class="PARAMETER">relation</replaceable> [ CASCADE | RESTRICT ]
  </synopsis>

  <refsect2 id="R2-SQL-DROPRULE-1">
   <refsect2info>
    <date>1998-09-22</date>
   </refsect2info>
   <title>
    输入
   </title>
   <para>
    <variablelist>
     <varlistentry>
      <term><replaceable class="parameter">name</replaceable></term>
      <listitem>
       <para>
	要删除的已存在规则的名称。
       </para>
      </listitem>
     </varlistentry>
     <varlistentry>
      <term><replaceable class="parameter">relation</replaceable></term>
      <listitem>
       <para>
	该规则所适用的关系的名称（可以有模式限定）。
       </para>
      </listitem>
     </varlistentry>
     <varlistentry>
      <term>CASCADE</term>
      <listitem>
       <para>
        自动删除依赖于该规则的对象。
       </para>
      </listitem>
     </varlistentry>
     <varlistentry>
      <term>RESTRICT</term>
      <listitem>
       <para>
        如果存在依赖对象则拒绝删除该规则。这是默认值。
       </para>
      </listitem>
     </varlistentry>
    </variablelist>

   </para>
  </refsect2>

  <refsect2 id="R2-SQL-DROPRULE-2">
   <refsect2info>
    <date>1998-09-22</date>
   </refsect2info>
   <title>
    输出
   </title>
   <para>
    <variablelist>
     <varlistentry>
      <term><computeroutput>
DROP RULE
       </computeroutput></term>
      <listitem>
       <para>
	成功时返回的消息。
       </para>
      </listitem>
     </varlistentry>
     <varlistentry>
      <term><computeroutput>
ERROR:  Rule "<replaceable class="parameter">name</replaceable>" not found
       </computeroutput></term>
      <listitem>
       <para>
	如果指定的规则不存在，就会出现这条消息。
       </para>
      </listitem>
     </varlistentry>
    </variablelist>
   </para>
  </refsect2>
 </refsynopsisdiv>

 <refsect1 id="R1-SQL-DROPRULE-1">
  <refsect1info>
   <date>1998-09-22</date>
  </refsect1info>
  <title>
   描述
  </title>
  <para>
   <command>DROP RULE</command>从指定的
   <productname>PostgreSQL</productname>
   规则系统中删除一个规则。<productname>PostgreSQL</productname>
   会立即停止强制执行该规则，并从系统目录中清除其定义。
  </para>

  <refsect2 id="R2-SQL-DROPRULE-3">
   <refsect2info>
    <date>1998-09-22</date>
   </refsect2info>
   <title>
    注意
   </title>
   <para>
    <command>DROP RULE</command>语句是一种
    <productname>PostgreSQL</productname>
    语言扩展。
   </para>

   <para>
    关于如何创建规则的信息，请参考
    <command>CREATE RULE</command>。
   </para>
  </refsect2>
 </refsect1>

 <refsect1 id="R1-SQL-DROPRULE-2">
  <title>
   用法
  </title>
  <para>
   删除重写规则 <literal>newrule</literal>：

   <programlisting>
DROP RULE newrule ON mytable;
   </programlisting>
  </para>
 </refsect1>

 <refsect1 id="R1-SQL-DROPRULE-3">
  <title>
   兼容性
  </title>

  <refsect2 id="R2-SQL-DROPRULE-5">
   <refsect2info>
    <date>1998-09-22</date>
   </refsect2info>
   <title>
    SQL92
   </title>
   <para>
    SQL92 中没有 <command>DROP RULE</command>。
   </para>
  </refsect2>
 </refsect1>
</refentry>

