      <entry><type>sql_identifier</type></entry>
      <entry>
       对应 <productname>PostgreSQL</> 不支持的特性
      </entry>
     </row>

     <row>
      <entry><literal>collation_catalog</literal></entry>
      <entry><type>sql_identifier</type></entry>
      <entry>
       对应 <productname>PostgreSQL</> 不支持的特性
      </entry>
     </row>

     <row>
