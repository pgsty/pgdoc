Branch: REL9_2_STABLE [f3c67aad4] 2015-05-28 11:24:37 -0400
-->

    <listitem>
     <para>
      Fix <function>pg_get_functiondef()</> to show
      functions' <literal>LEAKPROOF</> property, if set (Jeevan Chalke)
     </para>
    </listitem>

<!--
