Branch: REL9_3_STABLE [534a4159c] 2015-12-23 14:25:31 -0500
-->

    <listitem>
     <para>
      Avoid repeated password prompts during parallel <application>pg_dump</>
      (Zeus Kronion)
     </para>
    </listitem>

<!--
