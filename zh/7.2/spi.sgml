<DATE>2001-11-14</DATE>
</REFSECT2INFO>
<TITLE>输出
</TITLE>
<VARIABLELIST>
<VARLISTENTRY>
<TERM>Portal
</TERM>
<LISTITEM>
<PARA>
   指向具有给定名称的 Portal 的指针，找不到时为 NULL
</para>
</LISTITEM>
</VARLISTENTRY>
</VARIABLELIST>
</REFSECT2>
