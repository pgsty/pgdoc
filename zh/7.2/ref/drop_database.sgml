PostgreSQL documentation
-->

<refentry id="SQL-DROPDATABASE">
 <refmeta>
  <refentrytitle id="SQL-DROPDATABASE-TITLE">
   DROP DATABASE
  </refentrytitle>
  <refmiscinfo>SQL - Language Statements</refmiscinfo>
 </refmeta>

 <refnamediv>
  <refname>
   DROP DATABASE
  </refname>
  <refpurpose>
   删除一个数据库
  </refpurpose>
 </refnamediv>

 <refsynopsisdiv>
  <refsynopsisdivinfo>
   <date>1999-12-11</date>
  </refsynopsisdivinfo>
  <synopsis>
DROP DATABASE <replaceable class="PARAMETER">name</replaceable>
  </synopsis>

  <refsect2 id="R2-SQL-DROPDATABASE-1">
   <refsect2info>
    <date>1999-12-11</date>
   </refsect2info>
   <title>
    输入
   </title>
   <para>
    <variablelist>
     <varlistentry>
      <term><replaceable class="PARAMETER">name</replaceable></term>
      <listitem>
       <para>
	要删除的现有数据库的名称。
       </para>
      </listitem>
     </varlistentry>
    </variablelist>
   </para>
  </refsect2>

  <refsect2 id="R2-SQL-DROPDATABASE-2">
   <refsect2info>
    <date>1999-12-11</date>
   </refsect2info>
   <title>
    输出
   </title>
   <para>

    <variablelist>

     <varlistentry>
      <term><computeroutput>DROP DATABASE</computeroutput></term>
      <listitem>
       <para>
	命令成功时返回此消息。
       </para>
      </listitem>
     </varlistentry>

     <varlistentry>
      <term><computeroutput>DROP DATABASE: cannot be executed on the currently open database</computeroutput></term>
      <listitem>
       <para>
        你不能连接在你将要删除的数据库上。
        请改为连接到<literal>template1</literal>或任何其他
        数据库，然后再次运行这条命令。
       </para>
      </listitem>
     </varlistentry>

     <varlistentry>
      <term><computeroutput>DROP DATABASE: may not be called in a transaction block</computeroutput></term>
      <listitem>
       <para>
        你必须先完成进行中的事务，然后才能调用这条命令。
       </para>
      </listitem>
     </varlistentry>

    </variablelist>
   </para>
  </refsect2>
 </refsynopsisdiv>

 <refsect1 id="R1-SQL-DROPDATABASE-1">
  <refsect1info>
   <date>1999-12-11</date>
  </refsect1info>
  <title>
   描述
  </title>

  <para>
   <command>DROP DATABASE</command>删除现有数据库的目录项并删除
   包含数据的目录。它只能由数据库所有者（通常是创建它的
   用户）执行。
  </para>

  <para>
   <command>DROP DATABASE</command>无法撤销。请小心使用！
  </para>

  <refsect2 id="R2-SQL-DROPDATABASE-3">
   <refsect2info>
    <date>1999-12-11</date>
   </refsect2info>
   <title>
    注解
   </title>

   <para>
    当连接到目标数据库时无法执行这条命令。因此，改用 shell
    脚本<xref linkend="app-dropdb" endterm="app-dropdb-title">可能
    更方便，它是这条命令的一个包装。
   </para>

   <para>
    关于如何创建数据库的信息，请参阅
    <xref linkend="sql-createdatabase" endterm="sql-createdatabase-title">。
   </para>
  </refsect2>
 </refsect1>

 <refsect1 id="R1-SQL-DROPDATABASE-3">
  <title>
   兼容性
  </title>

  <refsect2 id="R2-SQL-DROPDATABASE-4">
   <refsect2info>
    <date>1998-04-15</date>
   </refsect2info>
   <title>
    SQL92
   </title>

   <para>
    <command>DROP DATABASE</command>语句是
    <productname>PostgreSQL</productname>的语言扩展；
    <acronym>SQL92</acronym>中没有这样的命令。
   </para>
  </refsect2>
 </refsect1>
</refentry>

