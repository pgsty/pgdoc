PostgreSQL documentation
-->

<REFENTRY ID="SQL-CURRENT-TIME">
 <REFMETA>
  <REFENTRYTITLE>
   SQL_CURRENT_TIME
  </REFENTRYTITLE>
  <REFMISCINFO>SQL - 函数</REFMISCINFO>
 </REFMETA>
 <REFNAMEDIV>
  <REFNAME>
   CURRENT_TIME
  </REFNAME>
  <REFPURPOSE>
返回当前本地时间
  </REFPURPOSE>
 <REFSYNOPSISDIV>
  <REFSYNOPSISDIVINFO>
   <DATE>1998-04-15</DATE>
  </REFSYNOPSISDIVINFO>
  <SYNOPSIS>
   CURRENT_TIME 
  </SYNOPSIS>
  
  <REFSECT2 ID="R2-SQL-CURRENT-TIME-1">
   <REFSECT2INFO>
    <DATE>1998-04-15</DATE>
   </REFSECT2INFO>
   <TITLE>
    输入
   </TITLE>
   <PARA>
无。
   
  </REFSECT2>
  
  <REFSECT2 ID="R2-SQL-CURRENT-TIME-2">
   <REFSECT2INFO>
    <DATE>1998-04-15</DATE>
   </REFSECT2INFO>
   <TITLE>
    输出
   </TITLE>
   <PARA>
       <VARIABLELIST>
	<VARLISTENTRY>
	 <TERM>
	  <replaceable>time</replaceable>

	 <LISTITEM>
	  <PARA>
	  <ReturnValue>返回"<replaceable class="parameter">now</replaceable>"</ReturnValue>

   </VARIABLELIST>
  </REFSECT2>
 </REFSYNOPSISDIV>
 
 <REFSECT1 ID="R1-SQL-CURRENT-TIME-1">
  <REFSECT1INFO>
   <DATE>1998-04-15</DATE>
  </REFSECT1INFO>
  <TITLE>
   描述
  </TITLE>
  <PARA>
   CURRENT_TIME 是一个无参（niladic）函数，其数据类型为
   TIME，它在运行时返回本地时间。
  </PARA>
  
  <REFSECT2 ID="R2-SQL-CURRENT-TIME-3">
   <REFSECT2INFO>
    <DATE>1998-04-15</DATE>
   </REFSECT2INFO>
   <TITLE>
    注意
   </TITLE>
   <PARA> 有关本地时间的进一步描述，请参阅 SET TIME ZONE 语句。
   </PARA>
  </REFSECT2>
  
 <REFSECT1 ID="R1-SQL-CURRENT-TIME-2">
  <TITLE>
   用法
  </TITLE>
  <PARA>显示 CURRENT_TIME：
  </PARA>
  <ProgramListing>
   SELECT CURRENT_TIME AS now;

   now
   -----------
   17:41:31+02

  </ProgramListing>
 </REFSECT1>
 
 <REFSECT1 ID="R1-SQL-CURRENT-TIME-3">
  <TITLE>
   兼容性
  </TITLE>
  <PARA>
  </PARA>
  
  <REFSECT2 ID="R2-SQL-CURRENT-TIME-4">
   <REFSECT2INFO>
    <DATE>1998-04-15</DATE>
   </REFSECT2INFO>
   <TITLE>
    SQL92
   </TITLE>
   <PARA>
    SQL92 为 CURRENT_TIME 规定了一些额外的能力：
   </PARA>
   <VARIABLELIST>
    <VARLISTENTRY>
     <TERM>
     </TERM>
     <LISTITEM>
      <PARA>
       <VARIABLELIST>
	<VARLISTENTRY>
	 <TERM>
	  <ReturnValue>
	   CURRENT_TIME [ (<replaceable class="parameter">scale</replaceable>) ]</ReturnValue>
	 </TERM>
	 <LISTITEM>
	  <PARA>
	   CURRENT_TIME 的可选精度（如果指定）是一个无符号整数，表示该函数所表示的时间值中可选的秒小数部分的位数。
	  </PARA>
	 </LISTITEM>
	</VARLISTENTRY>
       </VARIABLELIST>
     </LISTITEM>
    </VARLISTENTRY>
   </VARIABLELIST>
</REFENTRY>

