PostgreSQL documentation
-->

<REFENTRY ID="SQL-CURRENT-USER">
 <REFMETA>
  <REFENTRYTITLE>
   SQL_CURRENT_USER
  </REFENTRYTITLE>
  <REFMISCINFO>SQL - 函数</REFMISCINFO>
 </REFMETA>
 <REFNAMEDIV>
  <REFNAME>
   CURRENT_USER
  </REFNAME>
  <REFPURPOSE>
   返回当前的用户名
  </REFPURPOSE>
 <REFSYNOPSISDIV>
  <REFSYNOPSISDIVINFO>
   <DATE>1998-04-15</DATE>
  </REFSYNOPSISDIVINFO>
  <SYNOPSIS>
   CURRENT_USER 
  </SYNOPSIS>
  
  <REFSECT2 ID="R2-SQL-CURRENT-USER-1">
   <REFSECT2INFO>
    <DATE>1998-04-15</DATE>
   </REFSECT2INFO>
   <TITLE>
    输入
   </TITLE>
   <PARA>

无。
  </REFSECT2>
  
  <REFSECT2 ID="R2-SQL-CURRENT-USER-2">
   <REFSECT2INFO>
    <DATE>1998-04-15</DATE>
   </REFSECT2INFO>
   <TITLE>
    输出
   </TITLE>
   <PARA>

       <VARIABLELIST>
	<VARLISTENTRY>
	 <TERM>
	  <replaceable>username</replaceable>
	 </TERM>
	 <LISTITEM>
	  <PARA>
当前用户的名称。

   </VARIABLELIST>
  </REFSECT2>
 </REFSYNOPSISDIV>
 
 <REFSECT1 ID="R1-SQL-CURRENT-USER-1">
  <REFSECT1INFO>
   <DATE>1998-04-15</DATE>
  </REFSECT1INFO>
  <TITLE>
   描述
  </TITLE>
  <PARA>
   无参数的（niladic）CURRENT_USER 函数返回一个 "name" 类型的字符串，其值代表用户名标识。
  </PARA>
  
  <REFSECT2 ID="R2-SQL-CURRENT-USER-3">
   <REFSECT2INFO>
    <DATE>1998-04-15</DATE>
   </REFSECT2INFO>
   <TITLE>
    注意
   </TITLE>
   <PARA>
    数据类型 "name" 是一个非标准的 31 字符类型，用于存储系统标识符。
   </PARA>
  </REFSECT2>
  
 <REFSECT1 ID="R1-SQL-CURRENT-USER-2">
  <TITLE>
   用法
  </TITLE>
  <PARA>
   显示 CURRENT_USER
  </PARA>
  <ProgramListing>
   SELECT CURRENT_USER AS who_am_i;

   who_am_i
   ------------
   jose
  </ProgramListing>
 </REFSECT1>
 
 <REFSECT1 ID="R1-SQL-CURRENT-USER-3">
  <TITLE>
   兼容性
  </TITLE>
  <PARA>
  </PARA>
  
  <REFSECT2 ID="R2-SQL-CURRENT-USER-4">
   <REFSECT2INFO>
    <DATE>1998-04-15</DATE>
   </REFSECT2INFO>
   <TITLE>
    SQL92
   </TITLE>
   <PARA>
   SQL92 规定了一些额外的无参数（niladic）USER 函数：
   </PARA>
   <variablelist>
    <varlistentry>
     <term>CURRENT_USER / USER</term>
     <listitem>
      <para>  
       USER 是 CURRENT_USER 的同义词。
      </para>
     </listitem>
    </varlistentry>
    <varlistentry>
     <term>SESSION_USER</term>
     <listitem>
      <para>
       SESSION_USER 函数返回 SQL 会话的用户名。
      </para>
     </listitem>
    </varlistentry>
    <varlistentry>
     <term>SYSTEM_USER</term>
     <listitem>
      <para>
       SYSTEM_USER 函数返回数据库的初始默认用户。
      </para>
     </listitem>
    </varlistentry>
   </variablelist>
   <para>
    无参数的（niladic）USER 函数返回一个 SQL_TEXT 字符串，其值代表一个用户名。
   </para>
  </refsect2>
 </refsect1>
</REFENTRY>

