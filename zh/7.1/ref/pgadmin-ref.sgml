Postgres documentation
-->

<refentry id="APP-PGADMIN">
 <refmeta>
  <refentrytitle id="app-pgadmin-title">
   <application>pgadmin</application>
  </refentrytitle>
  <manvolnum>1</manvolnum>
  <refmiscinfo>应用程序</refmiscinfo>
 </refmeta>
 <refnamediv>
  <refname>
   <application>pgadmin</application>
  </refname>
  <refpurpose>
   <productname>Postgres</productname>
   的 Windows 95/98/NT 数据库管理与设计工具
  </refpurpose>
 </refnamediv>
 <refsynopsisdiv>
  <refsynopsisdivinfo>
   <date>1999-12-24</date>
  </refsynopsisdivinfo>
  <synopsis>
pgadmin [ <replaceable class="parameter">datasourcename</replaceable> [ <replaceable class="parameter">username</replaceable> [ <replaceable class="parameter">password</replaceable> ] ] ]
  </synopsis>

  <refsect2 id="R2-APP-PGADMIN-1">
   <refsect2info>
    <date>1999-12-24</date>
   </refsect2info>
   <title>
    输入
   </title>
   <para>

    <variablelist>
     <varlistentry>
      <term><replaceable class="PARAMETER">datasourcename</replaceable></term>
      <listitem>
       <para>
	一个已有的<productname>Postgres</productname> ODBC 系统数据源或用户数据源的名字。
       </para>
      </listitem>
     </varlistentry>

     <varlistentry>
      <term><replaceable class="PARAMETER">username</replaceable></term>
      <listitem>
       <para>
	指定的<replaceable class="PARAMETER">datasourcename</replaceable>
	的一个有效用户名。
       </para>
      </listitem>
     </varlistentry>

     <varlistentry>
      <term><replaceable class="PARAMETER">password</replaceable></term>
      <listitem>
       <para>
	指定的<replaceable class="PARAMETER">datasourcename</replaceable>和
	<replaceable class="PARAMETER">username</replaceable>
	的一个有效口令。 
       </para>
      </listitem>
     </varlistentry>
    </variablelist>
   </para>
  </refsect2>

  <refsect2 id="R2-APP-PGADMIN-2">
   <refsect2info>
    <date>1999-12-24</date>
   </refsect2info>
   <title>
    输出
   </title>
   <para>
   </para>
  </refsect2>
 </refsynopsisdiv>

 <refsect1 id="R1-APP-PGADMIN-1">
  <refsect1info>
   <date>1999-12-24</date>
  </refsect1info>
  <title>
   描述
  </title>
  <para>
   <application>pgadmin</application>是一个用于设计、维护和管理
   <productname>Postgres</productname>数据库的通用工具。它运行在 Windows 95/98 和 NT 之下。
  </para>

  <para>
   它的特性包括：

   <itemizedlist>
    <listitem>
     <para>
      任意 SQL 输入。
     </para>
    </listitem>

    <listitem>
     <para>
      面向数据库、表、索引、序列、视图、触发器、函数和语言的信息浏览器和"创建器"。
     </para>
    </listitem>

    <listitem>
     <para>
      用户、组和权限配置对话框。
     </para>
    </listitem>

    <listitem>
     <para>
      带升级脚本生成的版本跟踪。
     </para>
    </listitem>

    <listitem>
     <para>
      Microsoft MSysConf 表的配置。
     </para>
    </listitem>

    <listitem>
     <para>
      数据导入和导出向导。
     </para>
    </listitem>

    <listitem>
     <para>
      数据库迁移向导。
     </para>
    </listitem>

    <listitem>
     <para>
      面向数据库、表、索引、序列、语言和视图的预定义报表。
     </para>
    </listitem>
   </itemizedlist>
  </para>

  <para>
   <application>pgadmin</application>与<productname>Postgres</productname>
   分开发布，可以从
   <ulink url="http://www.pgadmin.freeserve.co.uk">http://www.pgadmin.freeserve.co.uk</ulink>
   下载。
  </para>
 </refsect1>
</refentry>

