&func-ref;
-->

 &trigger;
 &spi;
 </part>

 <part id="programmer-pl">
  <title>过程语言</title>

  &xplang;
  &plsql;
  &pltcl;
  &plperl;
 </part>

<![%single-book;[
 &biblio;
]]>

</book>

